  "scale": {
    "heading-1": {
      "fontFamily": "Saans-Heavy",
      "fontSize": "calc(120px/60*var(--base-headings-primary-size) + 0px)",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
